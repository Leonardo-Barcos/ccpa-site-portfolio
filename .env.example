# ---------------------------------------------------------------
# CCPA - Área de Associados | Variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------

APP_NAME="Clube de Criativos do Pará"
APP_ENV=development                 # development | production
BASE_URL=http://localhost:8000      # URL pública (usada nos links do e-mail)
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

# Banco de dados
# dev:  sqlite+pysqlite:///./ccpa.db
# prod: postgresql+psycopg://usuario:senha@host:5432/ccpa
DATABASE_URL=sqlite+pysqlite:///./ccpa.db

# ------------------------- Resend ------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="CCPA <associados@ccpara.com.br>"
MAIL_REPLY_TO=criativosdopara@gmail.com
MAIL_BCC_ADMIN=criativosdopara@gmail.com     # cópia interna de cada adesão

# ---------------------- Pagamentos -----------------------------
# mock    -> gera link fake (para desenvolvimento/homologação interna)
# asaas   -> gateway Asaas (liquidação na conta Caixa da CCPA)
# manual  -> usa PAYMENT_STATIC_LINK abaixo (link de pagamento fixo)
PAYMENT_PROVIDER=mock

# Conta bancária de liquidação (Caixa Econômica Federal) - exibida no e-mail
BANK_NAME="Caixa Econômica Federal"
BANK_AGENCIA=0000
BANK_OPERACAO=003
BANK_CONTA=00000-0
BANK_PIX_KEY=00.000.000/0001-00
BANK_TITULAR="Clube de Criativos do Pará"

# Asaas (quando PAYMENT_PROVIDER=asaas)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3      # sandbox: https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Link de pagamento fixo (quando PAYMENT_PROVIDER=manual)
PAYMENT_STATIC_LINK=
